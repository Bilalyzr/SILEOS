# Environment Configuration for SashaInfinity LMS

# Environment
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=postgresql://tutor_user:tutor_password@postgres:5432/tutor_lms

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-long
JWT_SECRET=your-jwt-secret-change-in-production-must-be-secure
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3030", "https://yourdomain.com"]

# Email / SMTP Configuration
# For your VPS email server with RoundCube
SMTP_HOST=mail.yoursubdomain.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yoursubdomain.yourdomain.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=SashaInfinity LMS <noreply@yoursubdomain.yourdomain.com>

# Alternative SMTP settings:
# For SSL/TLS on port 465, use SMTP_SSL instead of SMTP with STARTTLS
# SMTP_PORT=465

# Payment (Razorpay)
RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret
# HMAC secret for the Razorpay webhook (Dashboard → Webhooks → Secret).
# Without it, POST /api/v1/payments/webhook returns 503 and only the
# reconciliation sweeper's gateway diff provides the safety net.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Meta WhatsApp Cloud API (campus notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APPROVED_TEMPLATES=campus_announcement,attendance_alert,assessment_reminder

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "gif", "pdf", "mp4", "mov", "avi", "mkv"]

# URLs
FRONTEND_URL=https://lms.sashainfinity.com
BACKEND_URL=https://backend.sashainfinity.com
DOMAIN=sashainfinity.com

# Logging
LOG_LEVEL=INFO
