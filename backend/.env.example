# Environment Configuration for SashaInfinity LMS

# Environment
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=postgresql://tutor_user:tutor_password@postgres:5432/tutor_lms

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-long
JWT_SECRET=your-jwt-secret-change-in-production-must-be-secure
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3030", "https://yourdomain.com"]

# Email / SMTP Configuration
# For your VPS email server with RoundCube
SMTP_HOST=mail.yoursubdomain.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yoursubdomain.yourdomain.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=SashaInfinity LMS <noreply@yoursubdomain.yourdomain.com>
ALERT_ON_SECURITY_EVENTS=false
SECURITY_ALERT_EMAIL=security@yoursubdomain.yourdomain.com

# Alternative SMTP settings:
# For SSL/TLS on port 465, use SMTP_SSL instead of SMTP with STARTTLS
# SMTP_PORT=465

# Payment (Razorpay)
RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret
# HMAC secret for the Razorpay webhook (Dashboard → Webhooks → Secret).
# Without it, POST /api/v1/payments/webhook returns 503 and only the
# reconciliation sweeper's gateway diff provides the safety net.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
ADMIN_EMAIL=operations@yoursubdomain.yourdomain.com
MIN_WITHDRAWAL_INR=500

# Company Invoicing (Seller Information)
# GSTIN of the organization issuing invoices
SELLER_GSTIN=
# Legal registered name of the seller/organization
SELLER_LEGAL_NAME=
# Full billing address for invoices
SELLER_ADDRESS=
# 2-digit numeric GST state code, e.g. 29 for Karnataka, 33 for Tamil Nadu, 07 for Delhi.
# Must match the buyer's company state_code format — an equal seller/buyer code is
# what selects CGST+SGST over IGST.
SELLER_STATE_CODE=
# Default GST rate percent applied to company invoices (default: 18.0)
GST_RATE_PERCENT=18.0

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "gif", "pdf", "mp4", "mov", "avi", "mkv"]

# URLs
FRONTEND_URL=https://lms.sashainfinity.com
BACKEND_URL=https://backend.sashainfinity.com
DOMAIN=sashainfinity.com

# Logging
LOG_LEVEL=INFO

# Live Classes (self-hosted Jitsi) — see docs/LIVE_CLASSES.md.
# Public URL of the Jitsi web host (deploy/compose.live.yml's jitsi-web).
JITSI_PUBLIC_URL=https://live.sashainfinity.com
JITSI_JWT_APP_ID=sashainfinity
# Dedicated Jitsi JWT signing secret — NEVER reuse JWT_SECRET. 64+ chars in
# production (openssl rand -hex 32). Blank is fine in dev/tests; production
# refuses to start without it (app/main.py lifespan).
JITSI_JWT_SECRET=
# Where the finalize-recordings worker looks for Jibri output before
# uploading to Bunny (deploy/scripts/finalize_recordings.py).
JITSI_RECORDINGS_DIR=recordings_live
# Shared secret for the internal recording-ingest endpoint
# (POST /api/v1/internal/live/recordings). 48+ chars in production
# (openssl rand -hex 24).
INTERNAL_TOKEN=
# Default timezone for scheduling live classes when a class doesn't specify one.
DEFAULT_TIMEZONE=Asia/Kolkata
# AI provider: Zhipu GLM (bigmodel.cn) — powers AI tutor, question + exam generation
# Admin-managed GLM and Gemini keys are encrypted in the database. This stable
# master secret must be independent from JWT and payment secrets.
AI_CREDENTIAL_ENCRYPTION_KEY=
GLM_API_KEY=
# GLM_MODEL=glm-4.5   # or glm-4-flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# DigiLocker / APAAR issuer adapter (WP8) — leave blank: the push endpoint answers an honest 503
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_ISSUER_ID=sashainfinity

# Live-class recording retention ceiling in days (owner decision 3: 1 year). Reports are never purged.
RECORDING_RETENTION_MAX_DAYS=365
