# =============================================================================
# deploy/.env.deploy — deployment configuration
# =============================================================================
# Copy to deploy/.env.deploy and adjust. This file holds DEPLOYMENT knobs only;
# application secrets stay in the repo-root .env, which the deploy scripts pass
# to docker compose separately.
#
# FORMAT RULE: this file is sourced by bash as well as read by docker compose, so
# keep it to plain KEY=value. No spaces around '=', no brackets, no quotes that
# span spaces, no command substitution. Anything more exotic belongs in .env
# (which is never sourced, only handed to compose).
#
# Precedence: real environment variables > this file > the defaults baked into
# deploy/scripts/lib.sh. That is what lets CI set RELEASE_TAG without editing
# anything on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Container registry
# -----------------------------------------------------------------------------
# Images are named ${REGISTRY}/${IMAGE_PREFIX}-{backend,frontend,streaming}:TAG.
#
# For CI-built images use the GitHub Container Registry path (lowercase owner):
#   REGISTRY=ghcr.io/sashainfinity
# For server-side builds (deploy.sh without --pull) leave it as "local"; the
# images are then only ever local and nothing is pushed anywhere.
REGISTRY=local
IMAGE_PREFIX=sasha-lms

# -----------------------------------------------------------------------------
# Edge proxy
# -----------------------------------------------------------------------------
# Port the edge publishes on the host. Defaults to 3200 rather than the 3100 the
# existing stack uses, so the blue-green stack can be validated side by side
# before anything is cut over. Point the host's system nginx / Cloudflare origin
# at this port when you are ready.
EDGE_HTTP_PORT=3200

# Bind address for that port. Keep 127.0.0.1 if a host-level nginx terminates TLS
# and proxies to it — then the edge is not directly reachable from the internet.
# Use 0.0.0.0 only if this container is genuinely the public entry point.
EDGE_BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# Shared docker network
# -----------------------------------------------------------------------------
DOCKER_NETWORK=sasha-net

# -----------------------------------------------------------------------------
# Data tier
# -----------------------------------------------------------------------------
# Volume names are pinned so this stack ADOPTS the volumes created by the
# original root docker-compose.yml instead of starting with an empty database.
# Verify against `docker volume ls` before your first deploy — getting this wrong
# means a new, empty Postgres.
POSTGRES_VOLUME=sasha_lms_postgres_data
REDIS_VOLUME=sasha_lms_redis_data

POSTGRES_USER=tutor
POSTGRES_DB=tutor_lms
POSTGRES_CONTAINER=sasha-postgres
# Host port for psql/backups; loopback-bound in the compose file.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Health gating — the settings that decide whether a release goes live
# -----------------------------------------------------------------------------
# Total budget for a new colour to become ready. The backend runs init_db() on
# startup and the image is large, so allow generous time: exceeding this aborts
# the deploy (safe), while setting it too low causes spurious failures.
HEALTH_TIMEOUT=180

# Seconds between probes.
HEALTH_INTERVAL=5

# Consecutive successful probes required. More than 1 on purpose — a single pass
# can come from a worker that is about to die.
HEALTH_RETRIES=3

# Budget for the post-switch end-to-end check through the edge.
EDGE_VERIFY_TIMEOUT=60

# Shorter gate during a rollback: in an incident, waiting is itself a cost.
ROLLBACK_HEALTH_TIMEOUT=90

# -----------------------------------------------------------------------------
# Switch behaviour
# -----------------------------------------------------------------------------
# Grace period after the traffic switch before the old colour is stopped, so
# in-flight video range requests and large uploads can finish. Raise it if you
# serve long-running requests.
DRAIN_SECONDS=15

# true  -> old colour is stopped but kept, making rollback a ~1s container start.
# false -> old colour is removed; rollback then has to recreate it from an image.
KEEP_PREVIOUS=true

# -----------------------------------------------------------------------------
# Runtime sizing
# -----------------------------------------------------------------------------
# uvicorn worker processes per backend container. Both colours run briefly at the
# same time during a deploy, so peak memory is roughly double this — size it
# against the server's RAM, not just steady state.
UVICORN_WORKERS=2

# -----------------------------------------------------------------------------
# Housekeeping
# -----------------------------------------------------------------------------
# Releases of images to keep. Must be >= 2 or you lose the ability to roll back.
IMAGE_RETENTION=3

# Deploy logs older than this are deleted by cleanup.sh.
LOG_RETENTION_DAYS=30

# Build cache ceiling on servers that build rather than pull.
PRUNE_BUILD_CACHE=true
BUILD_CACHE_KEEP=5GB
