# =============================================================================
# Live Classes — Jitsi stack environment (example)
# =============================================================================
# Copy this file to deploy/.env.live and fill in real values before running:
#
#   cp deploy/.env.live.example deploy/.env.live
#   docker compose -f deploy/compose.live.yml --env-file deploy/.env.live up -d
#
# deploy/.env.live is gitignored — NEVER commit the filled-in version.
# Generate strong secrets with:
#   openssl rand -hex 32     # JITSI_JWT_SECRET, component secrets (64 hex chars)
#   openssl rand -hex 24     # INTERNAL_TOKEN (48 hex chars) — see backend/.env.example
#
# The backend reads JITSI_PUBLIC_URL / JITSI_JWT_APP_ID / JITSI_JWT_SECRET /
# JITSI_RECORDINGS_DIR from its OWN env (see backend/.env.example) — this file
# is only consumed by docker-jitsi-meet's containers via `env_file: .env.live`
# in deploy/compose.live.yml. Keep the JITSI_JWT_SECRET value identical in
# both places or token minting and Prosody's JWT verification will disagree.
# =============================================================================

# -----------------------------------------------------------------------------
# Networking / public URL
# -----------------------------------------------------------------------------
# Docker network shared with the rest of the stack (see deploy/docker-compose.*).
DOCKER_NETWORK=sasha-net

# Public URL of the Jitsi deployment — what browsers/Flutter clients hit.
# TLS terminates at the aaPanel host, same as every other vhost; this stays
# https:// even though the container itself only listens on plain HTTP.
JITSI_PUBLIC_URL=https://live.sashainfinity.com
PUBLIC_URL=${JITSI_PUBLIC_URL}

# TLS terminates at the aaPanel host / Cloudflare (see 20-live.conf) — the
# jitsi-web container itself must stay plain HTTP. Uncomment ENABLE_LETSENCRYPT
# only if you ever run this stack WITHOUT a TLS-terminating front proxy.
DISABLE_HTTPS=1
ENABLE_LETSENCRYPT=0

TZ=Asia/Kolkata
DEFAULT_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# JWT auth (AUTH_TYPE=jwt) — backend mints room-pinned tokens
# -----------------------------------------------------------------------------
ENABLE_AUTH=1
AUTH_TYPE=jwt

# Must match app.core.config.settings.JITSI_JWT_APP_ID exactly.
JITSI_JWT_APP_ID=sashainfinity
JWT_APP_ID=${JITSI_JWT_APP_ID}

# changeme-* placeholder only. Generate a real 64-char hex secret with
# `openssl rand -hex 32` and set the SAME value here and in the backend's
# JITSI_JWT_SECRET (backend/.env.live / production env) — this is a DEDICATED
# secret, never the platform JWT_SECRET.
JITSI_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_APP_SECRET=${JITSI_JWT_SECRET}

# Do not allow unsigned/anonymous conferences.
JWT_ALLOW_EMPTY=0

# -----------------------------------------------------------------------------
# Lobby / recording feature flags
# -----------------------------------------------------------------------------
ENABLE_LOBBY=1
ENABLE_RECORDING=1

# Path INSIDE the jibri container (see compose.live.yml's jibri volume mount).
JIBRI_RECORDING_DIR=/config/recordings

# -----------------------------------------------------------------------------
# Recordings + internal ingest (§6.1) — consumed by Task 6's finalize worker
# (deploy/scripts/finalize_recordings.sh/.py) and by the backend's own env
# (backend/.env.example documents the SAME two variables for app.core.config).
# Keep the values identical in both places.
# -----------------------------------------------------------------------------
# HOST path (relative to deploy/, i.e. deploy/recordings) that the finalize
# worker scans for *.mp4 files — this is the compose bind-mount SOURCE for
# jibri's /config/recordings (see compose.live.yml), not a path inside any
# container.
JITSI_RECORDINGS_DIR=./recordings

# changeme-* placeholder only. Generate a real 48-char hex token with
# `openssl rand -hex 24` and set the SAME value here and in the backend's
# INTERNAL_TOKEN (backend/.env.live / production env) — this guards
# POST /api/v1/internal/live/recordings (X-Internal-Token header +
# loopback-only check).
INTERNAL_TOKEN=changeme-generate-with-openssl-rand-hex-24

# -----------------------------------------------------------------------------
# XMPP internal hostnames/domains — docker-jitsi-meet stable defaults
# -----------------------------------------------------------------------------
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_SERVER=prosody

JICOFO_AUTH_USER=focus
JVB_AUTH_USER=jvb
JIBRI_XMPP_USER=jibri
JIBRI_RECORDER_USER=recorder

# JVB sits behind the docker bridge network and by default advertises its
# private container IP in ICE candidates, which remote participants outside
# this host cannot reach for media even though signalling works. Uncomment
# and set to the server's public IP if remote participants join but get no
# audio/video. Supersedes the older DOCKER_HOST_ADDRESS variable.
# JVB_ADVERTISE_IPS=<public-ip>

# -----------------------------------------------------------------------------
# Component secrets — changeme-* placeholders only.
# Generate real ones with `openssl rand -hex 32` (or -hex 24), one per line,
# BEFORE the first `docker compose ... up`. Prosody bakes these into its
# local config on first boot; rotating them later means recreating the
# prosody/jicofo/jvb/jibri config volumes together (see docs/LIVE_CLASSES.md
# runbook once Task 10 lands).
# -----------------------------------------------------------------------------
JICOFO_COMPONENT_SECRET=changeme-generate-with-openssl-rand-hex-32
JICOFO_AUTH_PASSWORD=changeme-generate-with-openssl-rand-hex-32
JVB_AUTH_PASSWORD=changeme-generate-with-openssl-rand-hex-32
JIBRI_XMPP_PASSWORD=changeme-generate-with-openssl-rand-hex-32
JIBRI_RECORDER_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Optional coturn TURN relay (profile "turn" only — usually unnecessary
# behind Cloudflare/most NATs; enable only if WebRTC connectivity testing on
# the VPS shows clients failing ICE).
# -----------------------------------------------------------------------------
TURN_REALM=live.sashainfinity.com
TURN_STATIC_AUTH_SECRET=changeme-generate-with-openssl-rand-hex-32
