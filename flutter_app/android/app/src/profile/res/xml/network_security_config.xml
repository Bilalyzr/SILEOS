<?xml version="1.0" encoding="utf-8"?>
<!--
  PROFILE override: cleartext permitted so `flutter run --profile` can reach a
  LAN dev backend over HTTP. Only applies to profile builds; release stays strict.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
