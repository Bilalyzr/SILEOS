# Multi-stage build for production
FROM python:3.11-slim as backend-builder

# Set working directory
WORKDIR /app

# Install system dependencies for both backend and streaming
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    curl \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements for backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ /app/backend/

# Copy streaming service requirements and code
COPY streaming-service/requirements.txt /app/streaming/requirements.txt
RUN pip install --no-cache-dir -r /app/streaming/requirements.txt

# Copy streaming service code
COPY streaming-service/ /app/streaming/

# Copy frontend build output (from a separate build stage)
FROM node:18-alpine as frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps

COPY frontend/ ./
RUN npm run build --legacy-peer-deps

# Final production image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    curl \
    supervisor \
    nginx \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/nginx \
    && mkdir -p /var/cache/nginx \
    && mkdir -p /app/uploads \
    && mkdir -p /app/certificates \
    && mkdir -p /app/streaming/cache

RUN groupadd --system appuser && useradd --system --gid appuser --home-dir /app appuser

# Copy Python dependencies and backend code from backend-builder
COPY --from=backend-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=backend-builder /usr/local/bin /usr/local/bin

# Copy streaming service from backend-builder
COPY --from=backend-builder /app/streaming /app/streaming

# Copy frontend build from frontend-builder
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# Copy configuration files
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/conf.d/default.production.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy backend application
COPY --from=backend-builder /app/backend /app/backend

# Copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Only runtime data is writable by the application processes. Source and
# configuration remain root-owned and read-only to the non-root workers.
RUN mkdir -p /var/log/supervisor /var/log/sashainfinity /app/backend/invoices /app/backend/ebooks \
    && chown -R appuser:appuser /app/uploads /app/certificates /app/streaming/cache \
       /app/backend/invoices /app/backend/ebooks /var/log/supervisor /var/log/sashainfinity

# Environment variables
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Expose ports
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command
CMD []
