# Mail subdomain - proxy to host nginx for Roundcube
server {
    listen 80;
    server_name mail.sashainfinity.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name mail.sashainfinity.com;

    ssl_certificate /etc/letsencrypt/mail.sashainfinity.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/mail.sashainfinity.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://172.30.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
