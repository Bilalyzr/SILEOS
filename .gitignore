# Uploads
uploads/*
!uploads/.gitkeep
certificates/generated/*
!certificates/generated/.gitkeep
# Generated designer-template thumbnails from seed_designer_templates.py's
# best-effort Chrome render (app/routers/certificate_designer.py surfaces
# these to the frontend at runtime via a file-existence check — see
# designer_thumbnail_url() — so they never need to be committed). Scoped to
# the designer-{id}.png filename pattern so any future hand-curated legacy
# slug thumbnails placed in the same certificates/thumbnails/ directory
# (see certificates.py's _thumb()) are unaffected.
backend/certificates/thumbnails/designer-*.png
# Generated invoice PDFs (backend/invoices/ when run from backend cwd locally;
# ./invoices/ is the host bind-mount source for the production compose stacks)
backend/invoices/*
!backend/invoices/.gitkeep
/invoices/*
!/invoices/.gitkeep
# Private ebook library files (backend/ebooks/ — EBOOKS_ROOT default; never
# under uploads/, which nginx serves publicly). Same pattern as invoices/.
backend/ebooks/*
!backend/ebooks/.gitkeep
/ebooks/*
!/ebooks/.gitkeep
# Generated certificate render cache (HTML→PDF downloads + preview images)
certificates/cert_html_*.pdf
certificates/cert_img_*.png

