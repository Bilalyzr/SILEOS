.env.bak*
.env.*.bak

# =============================================================================
# Blue-green deployment (deploy/)
# =============================================================================
# Machine-local deployment state: which colour is live, which release each slot
# runs, the deploy history and the lock. Committing it would mean one server's
# state overwriting another's on the next pull.
deploy/state/

# Deployment config — contains registry paths and host-specific ports.
deploy/.env.deploy

# Live Classes — Jitsi stack secrets (JWT/component passwords). Committed
# example is deploy/.env.live.example; this real file is host-specific and
# must never be committed.
deploy/.env.live

# Live Classes — Jitsi bind-mounted config volumes. docker-jitsi-meet
# POPULATES these with generated XMPP credentials and certs on first boot
# (see compose.live.yml's ./jitsi/{web,prosody,jicofo,jvb,jibri} volumes) —
# a `git add -A` on the VPS after `up` would otherwise commit live secrets.
deploy/jitsi/

# Live Classes — Jibri recording output + finalize-worker sidecar files
# (bind-mounted at /config/recordings; see compose.live.yml + Task 6/7's
# finalize worker). Never committed: these are large media files, not code.
deploy/recordings/

# Runtime secrets mounted into containers (Firebase service-account JSON, etc).
deploy/secrets/*
!deploy/secrets/.gitkeep

# Maintenance-mode flag: enabling maintenance is an operational action on one
# host, never a commit.
deploy/nginx/maintenance/ON

# Per-run deploy logs and edge nginx access/error logs.
logs/deploy/
logs/edge-nginx/

# Live blue/green pointer, rewritten by deploy/scripts/switch.sh on every
# switch. Same reasoning as deploy/state/: it is one server's runtime state, so
# committing it would let one host's colour overwrite another's on the next
# pull. Bootstrap a fresh checkout by copying active.conf.example over it.
deploy/nginx/active/active.conf

# Certificate preview images generated at render time.
certificates/cert_img_*.webp

# Local 2FA setup artifacts — contain LIVE TOTP secrets, never commit
backend/_totp_*.png
backend/_totp_code.py

# Database backup artifacts — contain real user data, never commit
database/backups/*.sql.gz
database/backups/nightly/
database/backups/weekly/
database/backups/volume-snapshots/
database/backups/pgdata_recovered/

# IDS runtime artifacts — deny-lists and ban state are managed by sasha-ids
nginx/conf.d.local/99-ids-deny.conf
deploy/nginx/conf.d/99-ids-deny.conf
deploy/nginx/ids/

# Generated per-deploy by deploy-blue-green.sh (pins a per-build image tag)
docker-compose.green.yml
.venv/
.worktrees/

