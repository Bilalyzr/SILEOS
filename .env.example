# Firebase client API configuration (obtain from your own Firebase project)
VITE_FIREBASE_API_KEY=
FIREBASE_API_KEY=

# Database Configuration
DB_NAME=tutor_lms
DB_USER=tutor
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://tutor:your_secure_password_here@postgres:5432/tutor_lms

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your_super_secret_key_here_min_32_chars
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Configuration
RAZORPAY_KEY=rzp_test_your_key_here
RAZORPAY_SECRET=your_razorpay_secret_here
# HMAC secret for the Razorpay webhook (Dashboard → Webhooks → Secret).
# Without it, POST /api/v1/payments/webhook returns 503 and only the
# reconciliation sweeper's gateway diff provides the safety net.
RAZORPAY_WEBHOOK_SECRET=<webhook_secret>
# Payment-pipeline operational alerts go here; falls back to EMAIL_FROM.
ADMIN_EMAIL=

# Meta WhatsApp Cloud API (campus notifications)
# Create these in Meta Business Manager; keep tokens and secrets server-side.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Business number in international digits, without +, used for the opt-in link.
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Only approved template names listed here can be selected by a campus manager.
WHATSAPP_APPROVED_TEMPLATES=campus_announcement,attendance_alert,assessment_reminder

# Company Invoicing (Seller Information)
# GSTIN of the organization issuing invoices
SELLER_GSTIN=
# Legal registered name of the seller/organization
SELLER_LEGAL_NAME=
# Full billing address for invoices
SELLER_ADDRESS=
# 2-digit numeric GST state code, e.g. 29 for Karnataka, 33 for Tamil Nadu, 07 for Delhi.
# Must match the buyer's company state_code format — an equal seller/buyer code is
# what selects CGST+SGST over IGST.
SELLER_STATE_CODE=
# Default GST rate percent applied to company invoices (default: 18.0)
GST_RATE_PERCENT=18.0

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@sashainfinity.com

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600  # 100MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,mp4,mov,avi,mkv

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# SSL Settings (Production)
SSL_CERT_PATH=/etc/letsencrypt/live/sashainfinity.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/sashainfinity.com/privkey.pem

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# Live Classes (self-hosted Jitsi) — see docs/LIVE_CLASSES.md.
# Public URL of the Jitsi web host (deploy/compose.live.yml's jitsi-web,
# reachable at https://live.sashainfinity.com once DNS/edge are live).
JITSI_PUBLIC_URL=https://live.sashainfinity.com
JITSI_JWT_APP_ID=sashainfinity
# Dedicated Jitsi JWT signing secret — NEVER reuse JWT_SECRET. 64+ chars in
# production (openssl rand -hex 32). Blank is fine in dev/tests; production
# refuses to start without it (app/main.py lifespan).
JITSI_JWT_SECRET=
# Where the finalize-recordings worker looks for Jibri output before
# uploading to Bunny (deploy/scripts/finalize_recordings.py).
JITSI_RECORDINGS_DIR=recordings_live
# Shared secret for the internal recording-ingest endpoint
# (POST /api/v1/internal/live/recordings). 48+ chars in production
# (openssl rand -hex 24).
INTERNAL_TOKEN=
# Default timezone for scheduling live classes when a class doesn't specify one.
DEFAULT_TIMEZONE=Asia/Kolkata

# Domain Configuration
FRONTEND_URL=https://lms.sashainfinity.com
BACKEND_URL=https://backend.sashainfinity.com
DOMAIN=sashainfinity.com
# Prerender.io token for social media crawler support (free at https://www.prerender.io/)
PRERENDER_TOKEN=your-token-here
